pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {Blake3} from "../src/Blake3.sol";
import {PorwVerifier} from "../src/PorwVerifier.sol";

/// Differential tests against `conformance/sketch-tile-v2.json` (generated by
/// the Rust reference implementation): the Solidity port must be
/// bit-identical or it is not the same scheme.
contract ConformanceTest is Test {
    PorwVerifier v;

    // Fixture: reference model (4 tiles), scenario coverage {1,3}.
    bytes32 constant SCHEME_DIGEST = 0xc86051f5c7611584a756964d65c7482ae46704d278b20a9c33d182bc9a12f59f;
    bytes32 constant BUFFER_BLAKE3 = 0xc8d1539da345558a41094f357273c0a3a11a8128fde91627c0cd9a70c6a2a18c;
    bytes32 constant CHALLENGE = 0x0909090909090909090909090909090909090909090909090909090909090909;
    bytes32 constant DEVICE = 0x0303030303030303030303030303030303030303030303030303030303030303;
    uint32 constant SLOT_SEED = 1970174283;

    bytes32 constant W0 = 0xc0d19bf1ac67d8498a97d1f250ff925403143a354aed252f79c059936b80c13e;
    bytes32 constant W1 = 0x492afa3610c1e6ffe8433d6184a923e0637304f7d6c640f618c0bf9fc5f8a2a0;
    bytes32 constant W2 = 0xbd88bc1657d2e7013c2b5ff697c1e026270c229385b59ec23e4273762287729d;
    bytes32 constant W3 = 0xe3545a99859a90ef71c2d6caeb46fa84cab7b86697f281f9d6224f7e085f12d6;
    bytes32 constant WEIGHTS_ROOT = 0xba938c5ec31b039172f85e94ba4a755c24a1a48c41e972306cc2f8e6d0651b46;
    bytes32 constant WEIGHTS_PARENT01 = 0x9a3751c6ae26c0df264d7a10a0237368bf8bf39d395126f302ad63923fad8533;

    bytes32 constant P0 = 0x910b4292da43be6453db0dd8fdfccef5f670093a1ef4f1eef7982fe164f51f99;
    bytes32 constant P1 = 0x7ca8121ed65f31e08a58ff3a28b24d2da5da2e9e6fa854636310090cc9c22510;
    bytes32 constant PARTIALS_ROOT = 0x6d322e7e30bea4f71be48d2027d9f7eea180580d01806ae9f09caf75061afb11;

    uint32 constant COMMITTED_S1 = 853679690; // tile 1 (honest)
    uint32 constant COMMITTED_S3 = 3046284449; // tile 3 (tampered)
    uint32 constant HONEST_S3 = 3046283020;

    bytes32 constant BEACON = 0x0815af9074d1eb1e6ee310dc7351c5ae5d6ece88df09eea0d078500c97d6abf4;

    function setUp() public {
        v = new PorwVerifier();
    }

    /// buf[i] = ((i * 2654435761) >> 7) & 0xFF, wrapping u64.
    function tileBytes(uint256 tileIdx) internal pure returns (bytes memory out) {
        out = new bytes(4096);
        unchecked {
            for (uint256 j = 0; j < 4096; j++) {
                uint64 x = uint64((tileIdx * 4096 + j) * 2654435761);
                out[j] = bytes1(uint8((x >> 7) & 0xFF));
            }
        }
    }

    function fullBuffer() internal pure returns (bytes memory out) {
        out = new bytes(16384);
        unchecked {
            for (uint256 j = 0; j < 16384; j++) {
                uint64 x = uint64(j * 2654435761);
                out[j] = bytes1(uint8((x >> 7) & 0xFF));
            }
        }
    }

    // ---- blake3 ----

    function test_blake3_single_block_scheme_digest() public pure {
        assertEq(Blake3.hash(bytes("aigg:porw:sketch-tile:v2")), SCHEME_DIGEST);
    }

    function test_blake3_empty_input() public pure {
        // blake3("") — well-known value.
        assertEq(Blake3.hash(""), 0xaf1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262);
    }

    function test_blake3_multi_chunk_tile_and_buffer() public pure {
        assertEq(Blake3.hash(fullBuffer()), BUFFER_BLAKE3);
    }

    function test_slot_seed_derivation() public view {
        assertEq(v.deriveSlotSeed(CHALLENGE, DEVICE), SLOT_SEED);
    }

    function test_partials_leaves() public view {
        assertEq(v.partialsLeaf(1, COMMITTED_S1), P0);
        assertEq(v.partialsLeaf(3, COMMITTED_S3), P1);
    }

    function test_weights_leaves_multi_chunk() public view {
        assertEq(v.weightsLeaf(0, tileBytes(0)), W0);
        assertEq(v.weightsLeaf(1, tileBytes(1)), W1);
        assertEq(v.weightsLeaf(2, tileBytes(2)), W2);
        assertEq(v.weightsLeaf(3, tileBytes(3)), W3);
    }

    function test_audit_beacon() public pure {
        bytes memory entropy = new bytes(32);
        for (uint256 i = 0; i < 32; i++) {
            entropy[i] = 0xab;
        }
        // blake3("porw-cross-audit-v1" || entropy || LE64 epoch)
        bytes memory epochLe = new bytes(8);
        epochLe[0] = 0x07;
        assertEq(Blake3.hash(bytes.concat("porw-cross-audit-v1", entropy, epochLe)), BEACON);
    }

    // ---- sketch ----

    function test_sketch_vectors_seed_1() public view {
        uint32[4] memory expected = [uint32(3485902744), 372182208, 1349964192, 38446344];
        for (uint64 i = 0; i < 4; i++) {
            assertEq(v.sketchTile(1, i, tileBytes(i)), expected[i]);
        }
    }

    function test_sketch_vectors_seed_deadbeef() public view {
        uint32[4] memory expected = [uint32(1557940684), 3400778530, 3931927942, 1241214034];
        for (uint64 i = 0; i < 4; i++) {
            assertEq(v.sketchTile(0xDEADBEEF, i, tileBytes(i)), expected[i]);
        }
    }

    function test_sketch_scenario_honest_tile_3() public view {
        assertEq(v.sketchTile(SLOT_SEED, 3, tileBytes(3)), HONEST_S3);
    }

    // ---- merkle + dispute paths ----

    function test_opening_committed() public view {
        bytes32[] memory proof = new bytes32[](1);
        proof[0] = P0;
        assertTrue(v.verifyOpeningCommitted(PARTIALS_ROOT, 2, 3, COMMITTED_S3, 1, proof));
        // Wrong value fails.
        assertFalse(v.verifyOpeningCommitted(PARTIALS_ROOT, 2, 3, HONEST_S3, 1, proof));
    }

    function test_opening_non_inclusion() public view {
        bytes32[] memory lp = new bytes32[](1);
        lp[0] = P1;
        bytes32[] memory rp = new bytes32[](1);
        rp[0] = P0;
        assertTrue(v.verifyOpeningNonInclusion(PARTIALS_ROOT, 2, 2, 1, COMMITTED_S1, 0, lp, 3, COMMITTED_S3, 1, rp));
        // A committed tile cannot be denied via a non-adjacent/false bracket.
        assertFalse(v.verifyOpeningNonInclusion(PARTIALS_ROOT, 2, 3, 1, COMMITTED_S1, 0, lp, 3, COMMITTED_S3, 1, rp));
    }

    function test_fraud_proof_verdicts() public view {
        bytes32[] memory pp = new bytes32[](1);
        pp[0] = P0;
        bytes32[] memory wp = new bytes32[](2);
        wp[0] = W2;
        wp[1] = WEIGHTS_PARENT01;
        // Tampered committed value: Fraud (0).
        assertEq(
            v.verifyTileFraudProof(
                PARTIALS_ROOT, WEIGHTS_ROOT, CHALLENGE, DEVICE, 3, COMMITTED_S3, 1, pp, tileBytes(3), wp
            ),
            0
        );
        // Non-canonical tile bytes: Invalid (2).
        bytes memory bad = tileBytes(3);
        bad[0] = bytes1(uint8(bad[0]) ^ 1);
        assertEq(
            v.verifyTileFraudProof(PARTIALS_ROOT, WEIGHTS_ROOT, CHALLENGE, DEVICE, 3, COMMITTED_S3, 1, pp, bad, wp), 2
        );
    }
}
