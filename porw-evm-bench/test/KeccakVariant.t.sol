pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {console2} from "forge-std/console2.sol";
import {PorwVerifier} from "../src/PorwVerifier.sol";

/// Differential tests against `conformance/sketch-tile-keccak-v1.json`
/// (generated by the Rust reference) plus the MEASURED gas for the full
/// keccak-variant fraud proof — the adopted cost-reduction step.
contract KeccakVariantTest is Test {
    PorwVerifier v;

    bytes32 constant SCHEME_DIGEST = 0x718b2eb3b33a6d18d904363ee1cc2fb797e344af10132ebfd93aef8d5d72e4b4;
    bytes32 constant CHALLENGE = 0x0909090909090909090909090909090909090909090909090909090909090909;
    bytes32 constant DEVICE = 0x0303030303030303030303030303030303030303030303030303030303030303;
    uint32 constant SLOT_SEED = 1663756538;

    bytes32 constant W0 = 0x3e50b5bf5ee971f084e3eaf064df0f93d71a96fb409e9fe6b199a9ee8b3524d9;
    bytes32 constant W2 = 0xaf6225bc93a62c4ff64f947e6f098749d56c997913085a0697faee7248ecee78;
    bytes32 constant WEIGHTS_ROOT = 0xaf9572c512a31d642b93e224a9a87813e3905848f4148422b407c1fc83fc48d3;
    bytes32 constant WEIGHTS_PARENT01 = 0x2582a60c0d95e91fa3011a68d031cd7163c8218b670f96242ab28508b80de9b9;

    bytes32 constant P0 = 0x1c84cc0a8f974d333948e32e6b8c272d1a1f919753bc3f3443a09270f935cabe;
    bytes32 constant P1 = 0xee8cd79465b30b6533601aa7d31dfbae744d410cda1fa13cb28c063855cad7f3;
    bytes32 constant PARTIALS_ROOT = 0x52d56c14e8b296b35974b521c1d4911b938c837d45a2c142bcf3e48483cca7b0;

    uint32 constant COMMITTED_S1 = 641493338;
    uint32 constant COMMITTED_S3 = 4186943441; // tampered
    uint32 constant HONEST_S3 = 4186940540;

    // Deep-path benchmark state (weights depth 25, partials depth 21).
    bytes tile;
    bytes32[] wProof;
    bytes32[] pProof;
    bytes32 deepModelRoot;
    bytes32 deepPartialsRoot;
    uint32 deepTrueS;

    function tileBytes(uint256 tileIdx) internal pure returns (bytes memory out) {
        out = new bytes(4096);
        unchecked {
            for (uint256 j = 0; j < 4096; j++) {
                uint64 x = uint64((tileIdx * 4096 + j) * 2654435761);
                out[j] = bytes1(uint8((x >> 7) & 0xFF));
            }
        }
    }

    function foldKeccak(bytes32 leaf, bytes32[] memory proof, uint256 index) internal pure returns (bytes32 acc) {
        acc = leaf;
        for (uint256 i = 0; i < proof.length; i++) {
            acc = index % 2 == 0 ? keccak256(bytes.concat(acc, proof[i])) : keccak256(bytes.concat(proof[i], acc));
            index /= 2;
        }
    }

    function setUp() public {
        v = new PorwVerifier();
        tile = tileBytes(3);
        deepTrueS = v.sketchTile(v.deriveSlotSeedKeccak(CHALLENGE, DEVICE), 3, tile);
        wProof = new bytes32[](25);
        for (uint256 i = 0; i < 25; i++) {
            wProof[i] = keccak256(abi.encode("w", i));
        }
        pProof = new bytes32[](21);
        for (uint256 i = 0; i < 21; i++) {
            pProof[i] = keccak256(abi.encode("p", i));
        }
        deepPartialsRoot = foldKeccak(v.partialsLeafKeccak(3, deepTrueS + 1), pProof, 1);
        deepModelRoot = foldKeccak(v.weightsLeafKeccak(3, tile), wProof, 3);
    }

    // ---- differential vs fixture ----

    function test_keccak_scheme_digest() public pure {
        assertEq(keccak256("aigg:porw:sketch-tile-keccak:v1"), SCHEME_DIGEST);
    }

    function test_keccak_slot_seed() public view {
        assertEq(v.deriveSlotSeedKeccak(CHALLENGE, DEVICE), SLOT_SEED);
    }

    function test_keccak_sketch_vector() public view {
        // Sketch math is shared; only the seed differs. Fixture per-tile
        // values under the keccak-derived seed.
        uint32[4] memory expected = [uint32(795232566), 641493338, 985004562, 4186940540];
        for (uint64 i = 0; i < 4; i++) {
            assertEq(v.sketchTile(SLOT_SEED, i, tileBytes(i)), expected[i]);
        }
    }

    function test_keccak_leaves_and_root() public view {
        assertEq(v.partialsLeafKeccak(1, COMMITTED_S1), P0);
        assertEq(v.partialsLeafKeccak(3, COMMITTED_S3), P1);
        assertEq(v.weightsLeafKeccak(0, tileBytes(0)), W0);
        assertEq(keccak256(bytes.concat(P0, P1)), PARTIALS_ROOT);
    }

    function test_keccak_fraud_proof_verdicts() public view {
        bytes32[] memory pp = new bytes32[](1);
        pp[0] = P0;
        bytes32[] memory wp = new bytes32[](2);
        wp[0] = W2;
        wp[1] = WEIGHTS_PARENT01;
        assertEq(
            v.verifyTileFraudProofKeccak(
                PARTIALS_ROOT, WEIGHTS_ROOT, CHALLENGE, DEVICE, 3, COMMITTED_S3, 1, pp, tileBytes(3), wp
            ),
            0 // Fraud
        );
        bytes memory bad = tileBytes(3);
        bad[0] = bytes1(uint8(bad[0]) ^ 1);
        assertEq(
            v.verifyTileFraudProofKeccak(
                PARTIALS_ROOT, WEIGHTS_ROOT, CHALLENGE, DEVICE, 3, COMMITTED_S3, 1, pp, bad, wp
            ),
            2 // Invalid
        );
    }

    function test_keccak_opening_committed() public view {
        bytes32[] memory proof = new bytes32[](1);
        proof[0] = P0;
        assertTrue(v.verifyOpeningCommittedKeccak(PARTIALS_ROOT, 2, 3, COMMITTED_S3, 1, proof));
        assertFalse(v.verifyOpeningCommittedKeccak(PARTIALS_ROOT, 2, 3, HONEST_S3, 1, proof));
    }

    // ---- measured gas (the adopted cost-reduction step) ----

    function test_gas_keccak_fraud_proof_full_path() public {
        uint256 g0 = gasleft();
        uint8 verdict = v.verifyTileFraudProofKeccak(
            deepPartialsRoot, deepModelRoot, CHALLENGE, DEVICE, 3, deepTrueS + 1, 1, pProof, tile, wProof
        );
        uint256 used = g0 - gasleft();
        assertEq(verdict, 0); // full path executed
        console2.log("verifyTileFraudProofKeccak (p21 + w25 + tile hash + sketch):", used);
    }

    function test_gas_keccak_opening_committed_depth21() public view {
        uint256 g0 = gasleft();
        v.verifyOpeningCommittedKeccak(deepPartialsRoot, 1 << 21, 3, deepTrueS + 1, 1, pProof);
        console2.log("verifyOpeningCommittedKeccak depth-21:", g0 - gasleft());
    }

    function test_gas_keccak_tile_hash() public view {
        uint256 g0 = gasleft();
        v.weightsLeafKeccak(3, tile);
        console2.log("weightsLeafKeccak (4104B keccak256):", g0 - gasleft());
    }
}
